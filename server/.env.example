# Backend (Express + Firebase Admin). Copy this file to server/.env.

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins. Use * only for local tests.
CORS_ORIGIN=http://localhost:5173

# Set to true when the API runs behind a trusted reverse proxy (Cloud Run, Render, etc.).
TRUST_PROXY=false

# Firebase project id and Storage bucket.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Option A (recommended for local development): paste the service account JSON
# on a single line. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: path to a service account JSON file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Business configuration (shared with the frontend through GET /api/config).
TAX_RATE=0.1
MAX_ITEM_QUANTITY=5
TIMEZONE=America/Mexico_City

# Logging and rate limits.
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CHECKOUT_RATE_LIMIT_MAX=30

# Cache of the admin home summary, in milliseconds (60000 = 1 minute).
DASHBOARD_CACHE_TTL_MS=60000

# Firebase emulators (optional). When any of these variables is present the
# API skips the service-account requirement.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
