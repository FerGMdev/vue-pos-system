{
  "name": "pos-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --workspace @pos/server",
    "dev:all": "concurrently -n web,api -c green,blue \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npm run seed --workspace @pos/server --",
    "set-role": "npm run set-role --workspace @pos/server --",
    "migrate:sales": "npm run migrate:sales --workspace @pos/server",
    "migrate:images": "npm run migrate:images --workspace @pos/server --",
    "backfill:summaries": "npm run backfill:summaries --workspace @pos/server --"
  },
  "dependencies": {
    "@formkit/themes": "^1.6.6",
    "@formkit/vue": "^1.6.6",
    "firebase": "^13.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3",
    "vue-tailwind-datepicker": "^1.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@tailwindcss/forms": "^0.5.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
