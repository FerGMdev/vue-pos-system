# Frontend (Vite). Copy this file to .env and fill in the values.
# Firebase Web App configuration: Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API base URL. Leave empty to use the Vite proxy (/api -> http://localhost:3000).
# In production use the full URL, for example https://api.example.com/api
VITE_API_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Set to true only when running the Firebase emulators locally.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
